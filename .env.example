# ============================================================
# Syntro Automação - Variáveis de ambiente (client side)
# Copie este arquivo para .env.local e preencha com valores reais.
#
# IMPORTANTE:
# - Todas as variáveis com NEXT_PUBLIC_ são embutidas no build e
#   ficam acessíveis no navegador. Portanto, NÃO coloque secrets
#   de servidor aqui (chaves de API de backend, senhas etc).
# ============================================================

# ------------------------------------------------------------
# Google Analytics 4 (GA4)
# ------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------
# Google Ads - tags de conversão (send_to)
# ------------------------------------------------------------
# Conversão principal: envio bem-sucedido do formulário
NEXT_PUBLIC_GOOGLE_ADS_FORM_SEND_TO=AW-828141749/xxxxxxxxxxxxxx

# Conversão secundária (opcional): clique em WhatsApp
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_SEND_TO=AW-828141749/yyyyyyyyyyyyyy

# Conversão secundária (opcional): clique em telefone (tel:)
NEXT_PUBLIC_GOOGLE_ADS_PHONE_SEND_TO=AW-828141749/zzzzzzzzzzzzzz

# ------------------------------------------------------------
# EmailJS (envio de formulário de contato)
# ------------------------------------------------------------
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx

# Template de notificação -> vai para contato@syntro.com.br
# (ou use NEXT_PUBLIC_EMAILJS_TEMPLATE_ID como fallback)
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID_NOTIFY=template_xxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxx

# Template de auto-reply -> vai para o usuário que preencheu
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID_AUTOREPLY=template_yyyyyy
