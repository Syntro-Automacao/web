# .htaccess - Configuração Completa para Next.js Static Export
# LiteSpeed/cPanel - Resolve URLs limpas e manifest.json

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # NEXT.JS STATIC EXPORT - CONFIGURAÇÃO ESPECÍFICA
  # Esta configuração é para arquivos gerados por 'next export' na pasta out/
  
  # 1. GARANTIR ACESSO A ARQUIVOS IMPORTANTES PRIMEIRO
  RewriteRule ^manifest\.json$ - [L]
  RewriteRule ^sitemap\.xml$ - [L]
  RewriteRule ^robots\.txt$ - [L]
  RewriteRule ^favicon\.ico$ - [L]
  
  # 2. ARQUIVOS ESTÁTICOS DO NEXT.JS (_next/)
  RewriteRule ^_next/(.*)$ - [L]
  
  # 3. ARQUIVOS DE ASSETS NORMAIS
  RewriteRule \.(css|js|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|eot)$ - [L]
  
  # 4. REDIRECIONAMENTO 301 - REMOVER .html DAS URLs
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/(.+)\.html [NC]
  RewriteRule ^ %1? [R=301,L]
  
  # 5. ADICIONAR .html INTERNAMENTE - SOMENTE PARA PÁGINAS INTERNAS
  # Regra principal: /contato/ → contato.html (internamente)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1\.html -f
  RewriteRule ^(contato|sobre|servicos|softwares-industriais|robos|blog|cases)/?$ $1.html [L]
  
  # 6. FALLBACK PARA INDEX.HTML (SPA ROUTING)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.html [L]
</IfModule>

# CONFIGURAÇÕES DE SEGURANÇA E CACHE
<IfModule mod_headers.c>
  # Cache para arquivos estáticos (1 ano)
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|eot)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
  
  # Cache para HTML (1 hora)
  <FilesMatch "\.html$">
    Header set Cache-Control "max-age=3600, public"
  </FilesMatch>
  
  # Headers específicos para arquivos importantes
  <Files "manifest.json">
    Header set Content-Type "application/json"
    Header set Cache-Control "max-age=3600, public"
  </Files>
  
  <Files "sitemap.xml">
    Header set Content-Type "application/xml"
    Header set Cache-Control "max-age=3600, public"
  </Files>
  
  <Files "robots.txt">
    Header set Content-Type "text/plain"
    Header set Cache-Control "max-age=3600, public"
  </Files>
</IfModule>

# COMPRESSÃO GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml
</IfModule>

# SEGURANÇA - BLOQUEAR APENAS ARQUIVOS REALMENTE SENSÍVEIS
<Files ~ "^\.">
  Order allow,deny
  Deny from all
</Files>

<Files ~ "package\.json$">
  Order allow,deny
  Deny from all
</Files>

<Files ~ "tsconfig\.json$">
  Order allow,deny
  Deny from all
</Files>

<Files ~ "next\.config\.(js|mjs|ts)$">
  Order allow,deny
  Deny from all
</Files>

# PERMITIR ARQUIVOS NECESSÁRIOS
<Files "manifest.json">
  Order allow,deny
  Allow from all
</Files>

<Files "sitemap.xml">
  Order allow,deny
  Allow from all
</Files>