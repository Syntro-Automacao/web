# .htaccess - Configuração para Next.js Static Export
# Remove a necessidade de digitar .html nas URLs

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Remove .html das URLs (redireciona permanentemente)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/(.+)\\.html [NC]
  RewriteRule ^ %1 [R=301,L]
  
  # Adiciona .html internamente quando não encontrado
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
  
  # Fallback para index.html se não existir
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Configurações de segurança e performance
<IfModule mod_headers.c>
  # Cache para arquivos estáticos (1 ano)
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|eot)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
  
  # Cache para HTML (1 hora)
  <FilesMatch "\.html$">
    Header set Cache-Control "max-age=3600, public"
  </FilesMatch>
  
  # Headers específicos para manifest.json e sitemap.xml
  <Files "manifest.json">
    Header set Content-Type "application/json"
    Header set Cache-Control "max-age=3600, public"
  </Files>
  
  <Files "sitemap.xml">
    Header set Content-Type "application/xml"
    Header set Cache-Control "max-age=3600, public"
  </Files>
</IfModule>

# Compressão Gzip para melhor performance
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml
</IfModule>

# Segurança - Esconder arquivos sensíveis
<Files ~ "^\.">
  Order allow,deny
  Deny from all
</Files>

<Files ~ "\.(json|lock|md)$">
  Order allow,deny
  Deny from all
</Files>