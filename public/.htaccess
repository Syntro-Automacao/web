# .htaccess - Next.js Static Export (cPanel / LiteSpeed)

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Arquivos importantes
  RewriteRule ^manifest\.json$ - [L]
  RewriteRule ^sitemap\.xml$ - [L]
  RewriteRule ^robots\.txt$ - [L]
  RewriteRule ^favicon\.ico$ - [L]

  # Arquivos do Next
  RewriteRule ^_next/ - [L]

  # Assets estáticos
  RewriteRule \.(css|js|mjs|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|eot|json|xml|txt|map)$ - [L]

  # ROTAS DINÂMICAS -> .html
  # /contato ou /contato/ -> contato.html
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # Home
  RewriteRule ^$ index.html [L]
</IfModule>

# CACHE E HEADERS
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|mjs|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|eot|map)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "max-age=3600, public"
  </FilesMatch>

  <Files "manifest.json">
    Header set Content-Type "application/json"
    Header set Cache-Control "max-age=3600, public"
  </Files>

  <Files "sitemap.xml">
    Header set Content-Type "application/xml"
    Header set Cache-Control "max-age=3600, public"
  </Files>

  <Files "robots.txt">
    Header set Content-Type "text/plain"
    Header set Cache-Control "max-age=3600, public"
  </Files>
</IfModule>

# GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml
</IfModule>

# SEGURANÇA
<Files ~ "^\.">
  Order allow,deny
  Deny from all
</Files>

<Files ~ "package\.json$">
  Order allow,deny
  Deny from all
</Files>

<Files ~ "tsconfig\.json$">
  Order allow,deny
  Deny from all
</Files>

<Files ~ "next\.config\.(js|mjs|ts)$">
  Order allow,deny
  Deny from all
</Files>

# PERMITIR
<Files "manifest.json">
  Order allow,deny
  Allow from all
</Files>

<Files "sitemap.xml">
  Order allow,deny
  Allow from all
</Files>